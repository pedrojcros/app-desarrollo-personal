{
  "name": "app-desarrollo-personal",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "expo start --lan",
    "web": "expo start --web --lan",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js --runInBand",
    "test:zones": "TZ=Europe/Madrid jest --config jest.config.js --runInBand src/domain && TZ=America/Los_Angeles jest --config jest.config.js --runInBand src/domain",
    "test:integration": "node --env-file-if-exists=.env node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "export:web": "expo export --platform web",
    "test:e2e": "sh docker/android/test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/slot": "1.5.2",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "56.0.23",
    "expo-constants": "56.0.27",
    "expo-linking": "56.0.18",
    "expo-router": "56.2.21",
    "expo-splash-screen": "56.0.15",
    "expo-status-bar": "56.0.4",
    "lucide-react-native": "1.52.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.5"
  },
  "overrides": {
    "react-test-renderer": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "56.0.4",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  }
}
